{
	"name": "wayfinder-atlas",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"description": "Experimental viewer for Matt Pocock wayfinder maps: markdown tickets drawn as a blocker DAG.",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"build": "velite build --clean --strict && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "velite build --strict && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"velite": "velite build --strict",
		"velite:watch": "velite dev",
		"content:summary": "bun scripts/print-content-summary.ts",
		"test": "bun test src/projection src/lib/wayfinder",
		"demo:projection": "bun scripts/demo-projection.ts",
		"harness": "timeout 30 bun scripts/dogfood-harness.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/bun": "^1.4.3",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"velite": "0.4.0",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@dagrejs/dagre": "^1.1.4",
		"@xyflow/svelte": "^1.0.0",
		"elkjs": "^0.12.0",
		"web-worker": "^1.5.0"
	}
}
